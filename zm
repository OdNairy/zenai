def cmd_merge(args, store):
    raw = store.read_raw()
    if not raw:
        die("no data. Run 'zm sync' first.")
    pending = store.read_pending()
    txs, pending_ids = apply_pending_overlay(raw, pending)
    lk = Lookup(raw)
    fmt = Formatter(lk)

    if len(args.ids) < 2:
        die("merge requires at least 2 IDs")

    resolved = resolve_ids(txs, args.ids)
    target = resolved[0]
    rest = resolved[1:]

    total_income = target.get("income", 0)
    total_outcome = target.get("outcome", 0)

    for tx in rest:
        total_income += tx.get("income", 0)
        total_outcome += tx.get("outcome", 0)
        store.add_pending("update", "transaction", tx["id"], {"deleted": False}, {"deleted": True})
        err(f"  soft-deleted {tx['id'][:8]}")

    old = {"income": target.get("income", 0), "outcome": target.get("outcome", 0)}
    new = {"income": total_income, "outcome": total_outcome}
    store.add_pending("update", "transaction", target["id"], old, new)
    err(f"  merged into {target['id'][:8]}: income={total_income}, outcome={total_outcome}")


def cmd_make_transfer(args, store):
    raw = store.read_raw()
    if not raw:
        die("no data. Run 'zm sync' first.")
    pending = store.read_pending()
    txs, pending_ids = apply_pending_overlay(raw, pending)
