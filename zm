def build_payee_tag_map(transactions):
    """Build map: payee_lower -> {tag_id: count} from all non-deleted transactions."""
    payee_tags = {}
    for tx in transactions:
        if tx.get("deleted"):
            continue
        payee = (tx.get("payee") or tx.get("originalPayee") or "").strip()
        if not payee:
            continue
        tags = tx.get("tag") or []
        key = payee.lower()
        if key not in payee_tags:
            payee_tags[key] = {}
        for tid in tags:
            payee_tags[key][tid] = payee_tags[key].get(tid, 0) + 1
    return payee_tags


def get_dominant_tag(tag_counts):
    """Return (tag_id, count, total) for most frequent tag, or None."""
    if not tag_counts:
        return None
    total = sum(tag_counts.values())
    best = max(tag_counts, key=tag_counts.get)
    return best, tag_counts[best], total


def review_ai_suggest(unknown_items, lk, store):
    """Call Anthropic API to classify unknown payees. Returns list of suggestions."""
    if not ANTHROPIC_TOKEN_FILE.exists():
        err("no anthropic token at data/anthropic_token, skipping AI suggestions")
        return []

    token = ANTHROPIC_TOKEN_FILE.read_text().strip()

    # Collect unique payees with amounts
    payee_amounts = {}
    for item in unknown_items:
        tx = item["tx"]
        payee = tx.get("payee") or tx.get("originalPayee") or "unknown"
        amount = tx.get("outcome", 0) or tx.get("income", 0)
        payee_amounts.setdefault(payee, []).append(amount)

    all_tags = sorted(set(t["title"] for t in lk.tags_by_id.values()))
    payee_list = "\n".join(f"- {p} (amounts: {', '.join(f'{a:.2f}' for a in amts)})"
                           for p, amts in payee_amounts.items())
    tag_list = ", ".join(all_tags)

    prompt = (
        f"Classify these merchant/payee names into expense categories.\n"
        f"Available categories: {tag_list}\n\n"
        f"Payees:\n{payee_list}\n\n"
        f"Respond with ONLY a JSON array: "
        f'[{{"payee": "...", "tag": "...", "confidence": 0.0-1.0}}]\n'
        f"Use only categories from the list above. If unsure, set confidence below 0.5. "
        f"If completely unknown, set tag to null."
    )

    body = json.dumps({
        "model": "claude-haiku-4-5-20251001",
        "max_tokens": 1024,
        "messages": [{"role": "user", "content": prompt}]
    }).encode()

    req = urllib.request.Request(
        ANTHROPIC_API_URL,
        data=body,
        headers={
            "Content-Type": "application/json",
            "x-api-key": token,
            "anthropic-version": "2023-06-01",
        },
    )

    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            result = json.loads(resp.read())
    except (urllib.error.HTTPError, urllib.error.URLError) as e:
        err(f"Anthropic API error: {e}")
        return []

    text = result["content"][0]["text"]
    # Extract JSON array from response
    import re
    json_match = re.search(r'\[.*\]', text, re.DOTALL)
    if not json_match:
        err("could not parse AI response")
        return []

    try:
        suggestions = json.loads(json_match.group())
    except json.JSONDecodeError:
        err("could not parse AI response JSON")
        return []

    # Map suggestions back to items
    payee_suggestion = {s["payee"].lower(): s for s in suggestions if s.get("tag")}
    ai_results = []
    for item in unknown_items:
        tx = item["tx"]
        payee = (tx.get("payee") or tx.get("originalPayee") or "").lower()
        s = payee_suggestion.get(payee)
        if not s:
            continue
        tag_match = lk.tags_by_name.get(s["tag"].lower())
        if tag_match:
            ai_results.append({
                "tx": tx,
                "suggested_tag": tag_match["id"],
                "confidence": s.get("confidence", 0),
                "source": "ai",
            })

    return ai_results


def cmd_review(args, store):
    raw = store.read_raw()
    if not raw:
        die("no data. Run 'zm sync' first.")
    pending = store.read_pending()
    txs, pending_ids = apply_pending_overlay(raw, pending)
    lk = Lookup(raw)
    fmt = Formatter(lk)

    payee_tags = build_payee_tag_map(txs)

    from_date = args.from_date or (datetime.now().strftime("%Y-%m") + "-01")
    to_date = args.to_date

    suspicious = []
    untagged_hist = []
    untagged_unknown = []

    for tx in txs:
        if tx.get("deleted"):
            continue
        d = tx.get("date", "")
        if d < from_date:
            continue
        if to_date and d > to_date:
            continue
        # skip transfers
        if tx.get("income", 0) > 0 and tx.get("outcome", 0) > 0:
            continue

        payee = (tx.get("payee") or tx.get("originalPayee") or "").strip()
        payee_key = payee.lower()
        history = payee_tags.get(payee_key, {})
        dominant = get_dominant_tag(history)
        tx_tags = tx.get("tag") or []

        if tx_tags:
            if dominant:
                dom_tid, dom_count, dom_total = dominant
                ratio = dom_count / dom_total
                if ratio >= 0.8 and dom_tid not in tx_tags:
                    suspicious.append({
                        "tx": tx,
                        "current_tags": tx_tags,
                        "suggested_tag": dom_tid,
                        "count": dom_count,
                        "total": dom_total,
                    })
        else:
            if dominant and payee:
                dom_tid, dom_count, dom_total = dominant
                untagged_hist.append({
                    "tx": tx,
                    "suggested_tag": dom_tid,
                    "count": dom_count,
                    "total": dom_total,
                })
            else:
                untagged_unknown.append({"tx": tx})

    # Sort all by date
    suspicious.sort(key=lambda x: x["tx"].get("date", ""), reverse=True)
    untagged_hist.sort(key=lambda x: x["tx"].get("date", ""), reverse=True)
    untagged_unknown.sort(key=lambda x: x["tx"].get("date", ""), reverse=True)

    # Print suspicious
    if suspicious:
        print(f"\nSUSPICIOUS — tag differs from history ({len(suspicious)}):")
        for item in suspicious:
            tx = item["tx"]
            cur_names = ", ".join(lk.tag_names(item["current_tags"]))
            sug_name = lk.tag_name(item["suggested_tag"])
            payee = tx.get("payee") or tx.get("originalPayee") or "—"
            print(f"  {tx['id'][:12]}  {tx.get('date','')}  {fmt.format_amount(tx):>16}  {payee}"
                  f"  {cur_names} → {sug_name}? ({item['count']}/{item['total']})")

    # Print untagged with suggestions
    if untagged_hist:
        print(f"\nUNTAGGED — suggestion from history ({len(untagged_hist)}):")
        for item in untagged_hist:
            tx = item["tx"]
            sug_name = lk.tag_name(item["suggested_tag"])
            payee = tx.get("payee") or tx.get("originalPayee") or "—"
            print(f"  {tx['id'][:12]}  {tx.get('date','')}  {fmt.format_amount(tx):>16}  {payee}"
                  f"  → {sug_name} ({item['count']}/{item['total']})")

    # AI tier
    ai_results = []
    if args.ai and untagged_unknown:
        err(f"\nCalling AI for {len(untagged_unknown)} unknown payee(s)...")
        ai_results = review_ai_suggest(untagged_unknown, lk, store)
        # Separate AI-resolved from still-unknown
        ai_resolved_ids = {item["tx"]["id"] for item in ai_results}
        still_unknown = [item for item in untagged_unknown if item["tx"]["id"] not in ai_resolved_ids]

        if ai_results:
            print(f"\nUNTAGGED — AI suggestion ({len(ai_results)}):")
            for item in ai_results:
                tx = item["tx"]
                sug_name = lk.tag_name(item["suggested_tag"])
                payee = tx.get("payee") or tx.get("originalPayee") or "—"
                conf = item.get("confidence", 0)
                print(f"  {tx['id'][:12]}  {tx.get('date','')}  {fmt.format_amount(tx):>16}  {payee}"
                      f"  → {sug_name} (confidence: {conf:.0%})")

        if still_unknown:
            print(f"\nUNTAGGED — unknown ({len(still_unknown)}):")
            for item in still_unknown:
                tx = item["tx"]
                payee = tx.get("payee") or tx.get("originalPayee") or "—"
                print(f"  {tx['id'][:12]}  {tx.get('date','')}  {fmt.format_amount(tx):>16}  {payee}")
    elif untagged_unknown:
        print(f"\nUNTAGGED — no history ({len(untagged_unknown)}):")
        for item in untagged_unknown:
            tx = item["tx"]
            payee = tx.get("payee") or tx.get("originalPayee") or "—"
            print(f"  {tx['id'][:12]}  {tx.get('date','')}  {fmt.format_amount(tx):>16}  {payee}")

    # Summary
    total = len(suspicious) + len(untagged_hist) + len(untagged_unknown)
    if total == 0:
        print("\nAll transactions look good!")
        return

    # Apply mode
    if not args.apply:
        print(f"\nUse --apply to interactively apply suggestions.")
        return

    # Collect confident suggestions
    to_apply = []
    for item in untagged_hist:
        if item["count"] >= 3:
            to_apply.append(item)
    for item in ai_results:
        if item.get("confidence", 0) >= 0.8:
            to_apply.append(item)

    if not to_apply:
        err("no confident suggestions to auto-apply.")
        return

    sys.stderr.write(f"\n{len(to_apply)} confident suggestion(s). Apply? [y/N] ")
    sys.stderr.flush()
    try:
        answer = input().strip().lower()
    except EOFError:
        return
    if answer != "y":
        err("skipped.")
        return

    for item in to_apply:
        tx = item["tx"]
        tag_id = item["suggested_tag"]
        store.add_pending("update", "transaction", tx["id"],
                         {"tag": tx.get("tag")}, {"tag": [tag_id]})
        err(f"  applied: {tx['id'][:12]} → {lk.tag_name(tag_id)}")

    err(f"applied {len(to_apply)} change(s). Use 'zm push' to send to API.")


def cmd_push(args, store):
    raw = store.read_raw()
    pending = store.read_pending()
    if not pending:
        err("nothing to push.")
        return

    # group mutations by (entity, id), merge fields
    merged = {}
    for mut in pending:
        key = (mut["entity"], mut["id"])
        if key not in merged:
            merged[key] = {"old": {}, "new": {}}
        merged[key]["old"].update(mut["old"])
        merged[key]["new"].update(mut["new"])

    # build diff payload
    diff_payload = {}
    for (entity, eid), changes in merged.items():
        # find original in raw
        originals = {x["id"]: x for x in raw.get(entity, [])}
        base = dict(originals.get(eid, {"id": eid}))
        base.update(changes["new"])
        base["changed"] = int(time.time())
        diff_payload.setdefault(entity, []).append(base)

    if args.dry_run:
        err("dry run — would push:")
        for entity, items in diff_payload.items():
            err(f"  {entity}: {len(items)} item(s)")
        print(json.dumps(diff_payload, ensure_ascii=False, indent=2))
        return

    token = store.read_token()
    client = ApiClient(token)
    state = store.read_state()

    # POST diff
    body = {
        "currentClientTimestamp": int(time.time()),
        "serverTimestamp": state["serverTimestamp"],
    }
    body.update(diff_payload)
    data = json.dumps(body).encode()
    req = urllib.request.Request(
        API_URL,
        data=data,
        headers={
            "Content-Type": "application/json",
            "Authorization": f"Bearer {token}",
        },
    )
    try:
        with urllib.request.urlopen(req, timeout=60) as resp:
            result = json.loads(resp.read())
    except urllib.error.HTTPError as e:
        body_text = e.read().decode(errors="replace")
        die(f"push failed: {e.code}: {body_text}")
    except urllib.error.URLError as e:
        die(f"push network error: {e.reason}")

    # update raw with response
    new_ts = result.get("serverTimestamp", state["serverTimestamp"])
    entities = ["transaction", "account", "tag", "merchant", "instrument"]
    for entity in entities:
        items = result.get(entity, [])
        if not items:
            continue
        existing = {x["id"]: x for x in raw.get(entity, [])}
        for item in items:
            existing[item["id"]] = item
        raw[entity] = list(existing.values())

    store.write_raw(raw)
    store.write_state({"serverTimestamp": new_ts})
    store.write_pending([])

    pushed_count = sum(len(v) for v in diff_payload.values())
    err(f"pushed {pushed_count} change(s). Pending cleared.")


