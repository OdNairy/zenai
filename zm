def cmd_convert_to_transfer(args, store):
    raw = store.read_raw()
    if not raw:
        die("no data. Run 'zm sync' first.")
    pending = store.read_pending()
    txs, pending_ids = apply_pending_overlay(raw, pending)
    lk = Lookup(raw)

    tx = resolve_id(txs, args.id)

    is_expense = tx.get("outcome", 0) > 0 and tx.get("income", 0) == 0
    is_income = tx.get("income", 0) > 0 and tx.get("outcome", 0) == 0

    if not is_expense and not is_income:
        die(f"{tx['id'][:8]} is already a transfer")

    if is_expense:
        if not args.to:
            die("expense transaction requires --to <account>")
        account = lk.resolve_account_name(args.to)
        old = {
            "income": tx.get("income", 0),
            "incomeAccount": tx.get("incomeAccount"),
            "incomeInstrument": tx.get("incomeInstrument"),
        }
        new = {
            "income": tx.get("outcome", 0),
            "incomeAccount": account["id"],
            "incomeInstrument": account.get("instrument"),
        }
        err(f"converting expense → transfer")
        err(f"  from: {lk.account_name(tx.get('outcomeAccount', ''))} ({tx.get('outcome', 0)})")
        err(f"  to:   {account['title']} ({new['income']})")
    else:
        if not args.from_account:
            die("income transaction requires --from <account>")
        account = lk.resolve_account_name(args.from_account)
        old = {
            "outcome": tx.get("outcome", 0),
            "outcomeAccount": tx.get("outcomeAccount"),
            "outcomeInstrument": tx.get("outcomeInstrument"),
        }
        new = {
            "outcome": tx.get("income", 0),
            "outcomeAccount": account["id"],
            "outcomeInstrument": account.get("instrument"),
        }
        err(f"converting income → transfer")
        err(f"  from: {account['title']} ({new['outcome']})")
        err(f"  to:   {lk.account_name(tx.get('incomeAccount', ''))} ({tx.get('income', 0)})")

    store.add_pending("update", "transaction", tx["id"], old, new)
    err(f"converted {tx['id'][:8]}")


def cmd_undo(args, store):
    pending = store.read_pending()
    if not pending:
        err("nothing to undo.")
        return

    if args.all:
        store.write_pending([])
        err(f"reverted all {len(pending)} pending changes.")
    elif args.id:
        prefix = args.id
        if len(prefix) < 4:
            die(f"ID prefix too short (min 4 chars): {prefix}")
        matching = [m for m in pending if m["id"].startswith(prefix)]
        if not matching:
            die(f"no pending changes for prefix: {prefix}")
        remaining = [m for m in pending if not m["id"].startswith(prefix)]
        store.write_pending(remaining)
        err(f"reverted {len(matching)} pending change(s) for {prefix}")
    else:
        removed = pending.pop()
        store.write_pending(pending)
        err(f"reverted: {removed['action']} {removed['entity']} {removed['id'][:8]}")


def cmd_batch(args, store):
    raw = store.read_raw()
    if not raw:
        die("no data. Run 'zm sync' first.")
    pending = store.read_pending()
    txs, pending_ids = apply_pending_overlay(raw, pending)
    lk = Lookup(raw)

    succeeded = 0
    failed = 0

    for lineno, line in enumerate(sys.stdin, 1):
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        try:
            obj = json.loads(line)
        except json.JSONDecodeError as e:
            err(f"line {lineno}: invalid JSON: {e}")
            failed += 1
            continue

        prefix = obj.get("id")
        if not prefix:
            err(f"line {lineno}: missing 'id' field")
            failed += 1
            continue

        try:
            tx = resolve_id(txs, prefix)
        except ResolveError as e:
            err(f"line {lineno}: {e}")
            failed += 1
            continue

        old = {}
        new = {}
        line_ok = True

        for field, value in obj.items():
            if field == "id":
                continue
            if field == "tags":
                try:
                    tag_ids = []
                    for name in value:
                        tid, title = lk.resolve_tag_name(name)
                        tag_ids.append(tid)
                    old["tag"] = tx.get("tag")
                    new["tag"] = tag_ids if tag_ids else None
                except ResolveError as e:
                    err(f"line {lineno}: {e}")
                    line_ok = False
                    break
            elif field in ("payee", "comment", "date"):
                old[field] = tx.get(field)
                new[field] = value
            elif field in ("outcome", "income"):
                old[field] = tx.get(field)
                new[field] = float(value)
            else:
                err(f"line {lineno}: unknown field '{field}', skipping")

        if not line_ok:
            failed += 1
            continue

        if new:
            if args.dry_run:
                err(f"line {lineno}: would edit {tx['id'][:12]}: {new}")
            else:
                store.add_pending("update", "transaction", tx["id"], old, new)
                err(f"line {lineno}: edited {tx['id'][:12]}: {list(new.keys())}")
            succeeded += 1
        else:
            err(f"line {lineno}: no changes for {tx['id'][:12]}")

    err(f"\nbatch complete: {succeeded} succeeded, {failed} failed")


